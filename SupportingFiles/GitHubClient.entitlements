<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Keychain Sharing capability (P1.5 — demonstrates entitlement
	  configuration). The app stays self-contained: KeychainSecureStorage
	  does not pass `kSecAttrAccessGroup`, so items live in the app's own
	  default access group at runtime. Listing the group below only enables
	  the capability for build-tooling purposes.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
</dict>
</plist>
